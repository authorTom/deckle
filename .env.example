# Deckle — Compose environment template.
#
# Copy this file to ".env" (same directory as compose.yaml) and edit as needed.
# Docker Compose reads a sibling ".env" automatically for ${...} interpolation.
# Real ".env" files are gitignored; only this template is tracked.
#
# Upgrading from when this app was called Nib? Your existing NIB_* names still
# work — the server maps them onto the DECKLE_* names below and logs which ones
# it honoured at startup. Rename them whenever suits you.

# Host port to publish the web UI on (container always listens on 8080).
DECKLE_PORT=8080

# Image to run. The default tracks the newest release.
#
#   :latest   the newest release            (default)
#   :1        newest 1.x — fixes and features, never a breaking change
#   :1.4      newest 1.4.x — fixes only
#   :1.4.2    exactly this release; never moves
#   :edge     the tip of main, unreleased. Deliberate testing, not deployment
#
# Pin an exact release for reproducible, rollback-friendly deploys, e.g.:
#   DECKLE_IMAGE=ghcr.io/authortom/deckle:1.0.0
# See the changelog before upgrading across a major:
#   https://github.com/authorTom/deckle/blob/main/CHANGELOG.md
DECKLE_IMAGE=ghcr.io/authortom/deckle:latest


# ---- Server library ----------------------------------------------------------
# With the server library on, your notes are stored as .md files in the container
# (the "nib-vault" volume in compose.yaml — named before the rename, and kept
# that way so upgrades don't strand it) instead of on your device — so Deckle
# works from any browser, including Safari and mobile, with nothing kept
# locally. The app still offers a local folder / in-browser library too; you pick
# on first load.
#
# Set to "false" to turn it off and run Deckle as the purely static app it was.
DECKLE_SERVER_LIBRARY=true

# Name shown in the app for the server library.
DECKLE_LIBRARY_NAME=My Notes

# Password for the server library.
#
# LEAVING THIS BLANK MEANS NO PASSWORD: anyone who can reach the port can read
# and write every note. That's fine when the port is already protected (a VPN,
# Tailscale, or an authenticating reverse proxy) and a bad idea otherwise.
# There is one shared password — Deckle has no user accounts.
DECKLE_PASSWORD=

# Optional. A fixed secret used to sign session cookies, so sign-ins survive a
# restart. Leave blank and a new one is generated at every boot, which signs
# everyone out. Generate one with:  openssl rand -base64 32
DECKLE_SESSION_SECRET=

# How long a sign-in lasts, in days (default 30).
# DECKLE_SESSION_TTL_DAYS=30

# Behind a reverse proxy — Caddy, Traefik, nginx, a Cloudflare Tunnel? Say so,
# so sign-in throttling sees each visitor's address rather than the proxy's.
# "true" means one proxy; use a number for a chain (Cloudflare in front of
# Caddy is 2). Leave it unset when browsers connect to Deckle directly:
# X-Forwarded-For is then ignored, because any client can write it.
#
# Unset behind a proxy, every visitor shares the proxy's address — so ten
# wrong passwords from anyone lock everyone out for fifteen minutes.
# DECKLE_TRUST_PROXY=true

# Optional. Where Deckle keeps its own state — currently the assistant settings
# shared by every device that signs in, API key included. Defaults to
# ".deckle-state" inside the library directory, which is the volume you already
# mount; it is deliberately *not* part of the library, so it never appears in a
# listing, an export or the API.
#
# Sharing those settings requires DECKLE_PASSWORD. Without one the server keeps
# no key at all — it would otherwise hand it to anyone who can reach the port —
# and every browser keeps its own, as it always has.
# DECKLE_STATE_DIR=/data/.deckle-state


# ---- API (for agents and scripts) ------------------------------------------
# Deckle exposes a REST API at /api/v1 so an agent can search, read and write your
# knowledge base. It is OFF unless you set a token below, and it needs the
# server library above — a local folder or in-browser library lives on your device,
# where nothing outside the browser can reach it.
#
# Comma-separated tokens. Each is either a bare secret (read-write) or
# "name:scope:secret", where scope is "r" (read-only) or "rw". Secrets must be
# at least 16 characters. Generate one with:  openssl rand -base64 32
#
#   DECKLE_API_TOKENS=hermes:rw:REPLACE_WITH_A_LONG_RANDOM_SECRET
#
# TREAT THESE LIKE PASSWORDS. A read-write token can create, edit and delete
# every note. Give each consumer its own token so you can revoke one without
# disturbing the rest, and prefer "r" for anything that only needs to read.
DECKLE_API_TOKENS=

# Optional. Origins allowed to call /api/v1 from a browser (comma-separated, or
# "*"). Leave blank unless a web page needs to call the API directly — a script
# or a server-side agent never needs this. Cookies are never accepted on
# /api/v1, so a permitted origin still has to present a token.
# DECKLE_API_CORS_ORIGINS=


# ---- AI assistant ----------------------------------------------------------
# Nothing to set here. API keys are entered in the app's assistant settings and
# stored in your browser — they are never sent to or held by the Deckle server.
